# 로컬에서 실제 구글/카카오 로그인을 테스트하려면 이 값들을 채우세요.
# 이 파일을 backend/.env로 복사해두면 me.paulschwarz:springboot4-dotenv(build.gradle.kts,
# developmentOnly)가 bootRun 시 자동으로 읽어들입니다 — 별도로 export하거나 IDE Run
# Configuration에 등록할 필요 없습니다. .env는 개발 전용이라 운영 배포에는 포함되지 않으며,
# 실제 OS 환경변수가 있으면 그게 항상 .env보다 우선합니다.
#
# 주의: .env는 UTF-8(BOM 없이) 로 저장하세요 — Windows 메모장 등으로 저장하면 파일 맨 앞에
# 보이지 않는 BOM이 붙어서 dotenv 파서가 "Malformed entry" 에러를 내며 기동에 실패합니다.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
JWT_SECRET=local-dev-only-secret-please-override-32-bytes-min
OAUTH2_STATE_SIGNING_KEY=local-dev-only-state-signing-key-please-override-32-bytes-min
OAUTH2_REDIRECT_URI=http://localhost:3000/oauth/callback
CORS_ALLOWED_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
# 커스텀 서브도메인(app.example.com/api.example.com) 배포 시에만 .example.com처럼 설정한다.
# *.localhost는 크롬이 서브도메인 간 쿠키 공유를 지원하지 않아 로컬에서는 비워둔다.
COOKIE_DOMAIN=

# access token blacklist / refresh token 저장소(Redis) + 그 외 도메인 캐싱 연결 준비용. 로컬은
# 기본값(localhost:6379, 비밀번호 없음) 그대로 두거나 `docker compose up -d redis` 또는
# `docker run --name algogyeyak-redis -p 6379:6379 -d redis:7-alpine`로 띄우면 된다. auth
# 쪽은 Redis가 없으면 fail-closed로 로그인/토큰 재발급이 거부되지만, 그 외 캐싱은 값을 안 채워도
# 앱 기동엔 영향 없다(Redis 미기동 시 연결만 안 될 뿐).
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

CLOVA_OCR_INVOKE_URL=
CLOVA_OCR_SECRET_KEY=
GEMINI_API_KEY=

# 카카오 로컬 API(주소검색, 좌표to법정동코드) - 매물 등록/시세비교에 필수. 카카오 디벨로퍼스
# REST API 키 그대로 사용(별도 상품 활성화 불필요).
KAKAO_REST_API_KEY=

# 국토교통부 실거래가 API(공공데이터포털). 반드시 "일반 인증키(Decoding)" 값을 사용할 것.
# 없어도 매물 등록/조회 자체는 되고 시세비교만 항상 UNAVAILABLE로 나온다(하드 의존성 아님).
MOLIT_SERVICE_KEY=

# 로그인 화면의 "개발자용 관리자 로그인" 버튼(POST /auth/dev-login) 스위치. 기본값 false —
# true로 켜면 시드된 admin 계정(비밀번호 없음, dev-login으로만 로그인 가능)이 생성된다.
# DEV_LOGIN_SECRET은 이 스위치가 켜졌을 때 요청에 같이 실려와야 하는 공유 비밀 값 — 운영에
# ENABLED=true로 배포할 거면 반드시 추측 불가능한 값으로 바꿀 것(비워두면 기동 자체가 실패한다).
# 프론트 쪽에서 이 값을 아는 사람만 `<프론트주소>/#devkey=<이 값>` 링크로 로그인할 수 있다
# (fragment를 쓰는 이유: 쿼리파라미터와 달리 서버/CDN 액세스 로그에 남지 않는다).
DEV_LOGIN_ENABLED=false
DEV_LOGIN_EMAIL=admin@algogyeyak.local
DEV_LOGIN_SECRET=local-dev-secret

KAKAO_REST_API_KEY=
MOLIT_SERVICE_KEY=

AWS_ACCESS_KEY=
AWS_SECRET_KEY=

RDS_ENDPOINT=
DB_NAME=
DB_USERNAME=
DB_PASSWORD=

GRAFANA_ADMIN_PASSWORD=
GRAFANA_ROOT_URL=